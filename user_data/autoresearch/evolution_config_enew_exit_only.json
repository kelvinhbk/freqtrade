{
  "llm": {
    "default_provider": "kimi",
    "fallback_order": ["kimi", "glm", "deepseek"],
    "temperature": 0.55,
    "max_tokens": 32768,
    "request_timeout": 120,
    "max_retries": 3,
    "providers": {
      "kimi": {
        "base_url": "https://api.kimi.com/coding",
        "api_key_env": "KIMI_API_KEY",
        "model": "kimi-2.6"
      },
      "glm": {
        "base_url": "https://open.bigmodel.cn/api/anthropic",
        "api_key_env": "GLM_API_KEY",
        "model": "glm-5.1"
      },
      "deepseek": {
        "base_url": "https://api.deepseek.com/anthropic",
        "api_key_env": "DEEPSEEK_API_KEY",
        "model": "deepseek-v4-pro"
      }
    }
  },
  "strategy_path": "user_data/strategies/ENEW.py",
  "base_config_path": "user_data/config_enew_backtest.json",
  "strategy_output_dir": "user_data/strategies/autoresearch_enew",
  "results_file": "user_data/autoresearch/results/enew_exit_only_experiments.jsonl",
  "timeframe": "5m",
  "pairs": [
    "DOT/USDT:USDT",
    "ENJ/USDT:USDT",
    "RENDER/USDT:USDT",
    "SOL/USDT:USDT",
    "TAO/USDT:USDT",
    "TON/USDT:USDT",
    "WLD/USDT:USDT",
    "ZEC/USDT:USDT"
  ],
  "in_sample_timerange": "20240701-20260201",
  "out_of_sample_timerange": "20260201-20260501",
  "max_iterations": 4,
  "max_walltime_hours": 4,
  "mutation_focus": "Exit-only ENEW refinement. Preserve the baseline entry edge exactly and only improve exit timing, profit capture, ROI schedule, sell-space parameters, and populate_exit_trend/custom_exit behavior. Use the recent experiment lessons to avoid repeating mutations that reduced OOS trades or OOS PnL.",
  "mutation_constraints": [
    "Keep populate_entry_trend byte-for-byte equivalent in behavior: same conditions, same enter_tag, same enter_long assignment.",
    "Do not add EMA/ADX/volume/trend/volatility filters to entry.",
    "Do not add, remove, rename, or change buy_* parameters or their ranges/defaults.",
    "Do not change custom_stoploss, stoploss, csl_* parameters, trailing_stop, or protections.",
    "You may add indicators only if they are used exclusively by custom_exit or populate_exit_trend.",
    "Prefer one small change: custom_exit, populate_exit_trend, sell_* parameters, or minimal_roi.",
    "The candidate must target OOS PnL >= baseline while reducing drawdown or improving PF."
  ],
  "hyperopt": {
    "loss_function": "AutoResearchMultiMetricLoss",
    "epochs": 500,
    "spaces": ["sell", "roi"],
    "jobs": 8,
    "analyze_per_epoch": true,
    "min_trades": 30,
    "early_stop": 100
  },
  "safety": {
    "max_drawdown_pct": 0.30,
    "min_trade_count": 30,
    "min_oos_trade_count": 10,
    "max_oos_drawdown_pct": 0.25,
    "require_oos_positive": true,
    "max_sharpe_degradation": 5.0,
    "walk_forward_splits": 3,
    "min_walk_forward_profitable": 2,
    "min_walk_forward_trades": 10,
    "min_oos_profit_vs_baseline": 1.0,
    "min_oos_sharpe_vs_baseline": 0.85,
    "min_oos_profit_factor_vs_baseline": 1.0,
    "max_oos_drawdown_vs_baseline": 1.2,
    "min_oos_trades_vs_baseline": 0.4,
    "min_is_profit_vs_baseline": 0.6,
    "min_is_sharpe_vs_baseline": 0.6
  },
  "score_weights": {
    "profit": 0.30,
    "sharpe": 0.25,
    "profit_factor": 0.15,
    "drawdown": 0.15,
    "trade_count": 0.10,
    "win_rate": 0.05,
    "calmar": 0.0,
    "in_sample": 0.25,
    "out_of_sample": 0.75
  }
}
